{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: % of people with each type of 12-month mental disorder, by age group. Radio buttons switch between everyone, females and males (ABS NSMHW 2020-22, Table 3).",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 320,
  "data": {
    "url": "data/nsmhw_disorder_age_sex.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number"
      }
    }
  },
  "params": [
    {
      "name": "sexChoice",
      "value": "Persons",
      "bind": {
        "input": "radio",
        "options": [
          "Persons",
          "Females",
          "Males"
        ],
        "labels": [
          "Everyone",
          "Females",
          "Males"
        ],
        "name": "Show: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.sex == sexChoice"
    }
  ],
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age group (years)",
      "axis": {
        "labelAngle": 0,
        "domain": false,
        "ticks": false
      }
    },
    "y": {
      "field": "disorder",
      "type": "nominal",
      "title": null,
      "sort": [
        "Any disorder",
        "Anxiety",
        "Affective (mood)",
        "Substance use"
      ],
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontWeight": 600
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "color": {
          "field": "percent",
          "type": "quantitative",
          "title": "% of age group",
          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              46
            ]
          },
          "legend": {
            "gradientLength": 220
          }
        },
        "tooltip": [
          {
            "field": "disorder",
            "title": "Disorder type"
          },
          {
            "field": "age_group",
            "title": "Age group"
          },
          {
            "field": "sex",
            "title": "Group"
          },
          {
            "field": "percent",
            "title": "% with this disorder (past 12 months)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 15,
        "fontWeight": 600
      },
      "encoding": {
        "text": {
          "field": "percent",
          "type": "quantitative",
          "format": ".0f"
        },
        "color": {
          "condition": {
            "test": "datum.percent > 22",
            "value": "white"
          },
          "value": "#13213a"
        }
      }
    }
  ]
}