{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: % with each type of 12-month mental disorder by age group. Radio buttons filter by sex. ABS NSMHW 2020-22 Table 3.",
  "width": 500,
  "height": 200,
  "data": {
    "url": "data/nsmhw_disorder_age_sex.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number"
      }
    }
  },
  "params": [
    {
      "name": "sexChoice",
      "value": "Persons",
      "bind": {
        "input": "radio",
        "options": [
          "Persons",
          "Females",
          "Males"
        ],
        "name": "Sex: "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.sex == sexChoice"
    }
  ],
  "mark": "rect",
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "title": "Age group"
    },
    "y": {
      "field": "disorder",
      "type": "nominal",
      "title": null
    },
    "color": {
      "field": "percent",
      "type": "quantitative",
      "title": "%",
      "scale": {
        "scheme": "purples",
        "domain": [
          0,
          46
        ]
      }
    },
    "tooltip": [
      {
        "field": "disorder"
      },
      {
        "field": "age_group"
      },
      {
        "field": "percent",
        "title": "%"
      }
    ]
  }
}
