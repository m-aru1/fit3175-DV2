{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dumbbell chart: % of each group with a 12-month disorder (purple) vs % who had one and saw a health professional (teal). The gap = people who did not get help. ABS NSMHW 2020-22 Table 6.",
  "width": 500,
  "height": 200,
  "data": {
    "url": "data/nsmhw_help_seeking.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent_of_population": "number"
      }
    }
  },
  "transform": [
    {
      "pivot": "status",
      "value": "percent_of_population",
      "groupby": [
        "sex",
        "age_group"
      ]
    },
    {
      "calculate": "datum['Saw a health professional']",
      "as": "saw"
    },
    {
      "calculate": "datum['Saw a health professional'] + datum['Did not']",
      "as": "total"
    },
    {
      "calculate": "datum.sex + ' ' + datum.age_group",
      "as": "group"
    }
  ],
  "encoding": {
    "y": {
      "field": "group",
      "type": "nominal",
      "title": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#ccc",
        "strokeWidth": 4
      },
      "encoding": {
        "x": {
          "field": "saw",
          "type": "quantitative",
          "title": "% of group"
        },
        "x2": {
          "field": "total"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 100,
        "color": "teal",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "saw",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "group"
          },
          {
            "field": "saw",
            "title": "Saw a professional (%)"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 100,
        "color": "#6a4c93",
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "total",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "group"
          },
          {
            "field": "total",
            "title": "Had a disorder (%)"
          }
        ]
      }
    }
  ]
}
