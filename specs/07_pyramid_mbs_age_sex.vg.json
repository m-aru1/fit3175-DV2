{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Butterfly/pyramid chart: people per 1,000 receiving Medicare mental health services in 2024-25 by age, males left, females right. Black tick = 2015-16. AIHW MBS Table MBS.4.",
  "data": {
    "url": "data/mbs_age_sex_trend.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "patients_per_1000": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.sex != 'Persons' && (datum.financial_year == '2024–25' || datum.financial_year == '2015–16')"
    },
    {
      "pivot": "financial_year",
      "value": "patients_per_1000",
      "groupby": [
        "sex",
        "age_group",
        "age_order"
      ]
    },
    {
      "calculate": "datum['2024–25']",
      "as": "now"
    },
    {
      "calculate": "datum['2015–16']",
      "as": "then"
    }
  ],
  "hconcat": [
    {
      "title": "Males",
      "width": 220,
      "height": 260,
      "transform": [
        {
          "filter": "datum.sex == 'Males'"
        }
      ],
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": {
            "field": "age_order",
            "order": "descending"
          },
          "axis": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "teal"
          },
          "encoding": {
            "x": {
              "field": "now",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  200
                ],
                "reverse": true
              },
              "title": "people per 1,000"
            },
            "tooltip": [
              {
                "field": "age_group"
              },
              {
                "field": "now",
                "title": "2024-25"
              },
              {
                "field": "then",
                "title": "2015-16"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "tick",
            "color": "black"
          },
          "encoding": {
            "x": {
              "field": "then",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  200
                ],
                "reverse": true
              },
              "title": "people per 1,000"
            }
          }
        }
      ]
    },
    {
      "width": 50,
      "height": 260,
      "transform": [
        {
          "filter": "datum.sex == 'Males'"
        }
      ],
      "mark": "text",
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": {
            "field": "age_order",
            "order": "descending"
          },
          "axis": null
        },
        "text": {
          "field": "age_group"
        }
      }
    },
    {
      "title": "Females",
      "width": 220,
      "height": 260,
      "transform": [
        {
          "filter": "datum.sex == 'Females'"
        }
      ],
      "encoding": {
        "y": {
          "field": "age_group",
          "type": "ordinal",
          "sort": {
            "field": "age_order",
            "order": "descending"
          },
          "axis": null
        }
      },
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#6a4c93"
          },
          "encoding": {
            "x": {
              "field": "now",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  200
                ],
                "reverse": false
              },
              "title": "people per 1,000"
            },
            "tooltip": [
              {
                "field": "age_group"
              },
              {
                "field": "now",
                "title": "2024-25"
              },
              {
                "field": "then",
                "title": "2015-16"
              }
            ]
          }
        },
        {
          "mark": {
            "type": "tick",
            "color": "black"
          },
          "encoding": {
            "x": {
              "field": "then",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  200
                ],
                "reverse": false
              },
              "title": "people per 1,000"
            }
          }
        }
      ]
    }
  ]
}
