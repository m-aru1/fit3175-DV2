{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map: circle area = people receiving Medicare mental health services 2024-25, colour = rate per 1,000. AIHW MBS Table MBS.3.",
  "width": 500,
  "height": 400,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eee",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "data/states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "k10_high_vhigh": "number",
            "mental_behavioural": "number",
            "disorder_12m": "number",
            "mbs_patients": "number",
            "mbs_rate": "number",
            "lon": "number",
            "lat": "number",
            "col": "number",
            "row": "number",
            "label_lon": "number",
            "label_lat": "number"
          }
        }
      },
      "mark": "circle",
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "size": {
          "field": "mbs_patients",
          "type": "quantitative",
          "title": "People",
          "scale": {
            "range": [
              30,
              2500
            ]
          }
        },
        "color": {
          "field": "mbs_rate",
          "type": "quantitative",
          "title": "per 1,000",
          "scale": {
            "scheme": "oranges"
          }
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "mbs_patients",
            "title": "People",
            "format": ","
          },
          {
            "field": "mbs_rate",
            "title": "per 1,000"
          }
        ]
      }
    }
  ]
}
