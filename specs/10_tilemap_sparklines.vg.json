{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tile-grid map: one square per state in rough map position; line = people per 1,000 receiving Medicare mental health services, 2015-16 to 2024-25. AIHW MBS Table MBS.3.",
  "width": 360,
  "height": 360,
  "layer": [
    {
      "data": {
        "url": "data/states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "k10_high_vhigh": "number",
            "mental_behavioural": "number",
            "disorder_12m": "number",
            "mbs_patients": "number",
            "mbs_rate": "number",
            "lon": "number",
            "lat": "number",
            "col": "number",
            "row": "number",
            "label_lon": "number",
            "label_lat": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.col + 0.05",
          "as": "x1"
        },
        {
          "calculate": "datum.col + 0.95",
          "as": "x2"
        },
        {
          "calculate": "datum.row + 0.05",
          "as": "y1"
        },
        {
          "calculate": "datum.row + 0.95",
          "as": "y2"
        }
      ],
      "mark": {
        "type": "rect",
        "color": "#eee"
      },
      "encoding": {
        "x": {
          "field": "x1",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ]
          },
          "axis": null
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y1",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ],
            "reverse": true
          },
          "axis": null
        },
        "y2": {
          "field": "y2"
        }
      }
    },
    {
      "data": {
        "url": "data/mbs_state_trend.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year_index": "number",
            "patients_per_1000": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.abbr != 'Australia'"
        },
        {
          "lookup": "abbr",
          "from": {
            "data": {
              "url": "data/states.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "k10_high_vhigh": "number",
                  "mental_behavioural": "number",
                  "disorder_12m": "number",
                  "mbs_patients": "number",
                  "mbs_rate": "number",
                  "lon": "number",
                  "lat": "number",
                  "col": "number",
                  "row": "number",
                  "label_lon": "number",
                  "label_lat": "number"
                }
              }
            },
            "key": "abbr",
            "fields": [
              "state",
              "col",
              "row"
            ]
          }
        },
        {
          "calculate": "datum.col + 0.1 + datum.year_index / 9 * 0.8",
          "as": "px"
        },
        {
          "calculate": "datum.row + 0.9 - (datum.patients_per_1000 - 40) / 80 * 0.6",
          "as": "py"
        }
      ],
      "mark": {
        "type": "line",
        "point": true
      },
      "encoding": {
        "x": {
          "field": "px",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ]
          },
          "axis": null
        },
        "y": {
          "field": "py",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ],
            "reverse": true
          },
          "axis": null
        },
        "detail": {
          "field": "abbr"
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "financial_year"
          },
          {
            "field": "patients_per_1000",
            "title": "per 1,000"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "k10_high_vhigh": "number",
            "mental_behavioural": "number",
            "disorder_12m": "number",
            "mbs_patients": "number",
            "mbs_rate": "number",
            "lon": "number",
            "lat": "number",
            "col": "number",
            "row": "number",
            "label_lon": "number",
            "label_lat": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum.col + 0.1",
          "as": "tx"
        },
        {
          "calculate": "datum.row + 0.2",
          "as": "ty"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left"
      },
      "encoding": {
        "x": {
          "field": "tx",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ]
          },
          "axis": null
        },
        "y": {
          "field": "ty",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              4
            ],
            "reverse": true
          },
          "axis": null
        },
        "text": {
          "field": "abbr"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
