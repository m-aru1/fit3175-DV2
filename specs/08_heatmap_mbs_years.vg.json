{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap: people per 1,000 receiving Medicare mental health services by age and financial year, females vs males. AIHW MBS Table MBS.4.",
  "data": {
    "url": "data/mbs_age_sex_trend.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "patients_per_1000": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.sex != 'Persons'"
    }
  ],
  "facet": {
    "column": {
      "field": "sex",
      "type": "nominal",
      "title": null
    }
  },
  "spec": {
    "width": 250,
    "height": 220,
    "mark": "rect",
    "encoding": {
      "x": {
        "field": "financial_year",
        "type": "ordinal",
        "title": null
      },
      "y": {
        "field": "age_group",
        "type": "ordinal",
        "sort": {
          "field": "age_order"
        },
        "title": "Age group"
      },
      "color": {
        "field": "patients_per_1000",
        "type": "quantitative",
        "title": "per 1,000",
        "scale": {
          "scheme": "purples"
        }
      },
      "tooltip": [
        {
          "field": "sex"
        },
        {
          "field": "age_group"
        },
        {
          "field": "financial_year"
        },
        {
          "field": "patients_per_1000",
          "title": "per 1,000"
        }
      ]
    }
  }
}
