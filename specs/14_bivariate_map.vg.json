                "tl": 134.8,
                "tt": -42.2,
                "ll": 138.6,
                "lt": -40.4,
                "sl": 143.4,
                "st": -37.2
              }
            ]
          },
          "mark": {
            "type": "rule",
            "color": "#13213a",
            "strokeWidth": 1.2
          },
          "encoding": {
            "longitude": {
              "field": "ll",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lt",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "sl"
            },
            "latitude2": {
              "field": "st"
            }
          }
        },
        {
