            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "How to read the colours",
        "fontSize": 12,
        "anchor": "start",
        "color": "#13213a"
      },
      "width": 110,
      "height": 110,
      "data": {
        "values": [
          {
            "group": "Lower distress, lower use",
            "distress": "Lower",
            "use": "Lower"
          },
          {
            "group": "Lower distress, higher use",
            "distress": "Lower",
            "use": "Higher"
          },
          {
            "group": "Higher distress, lower use",
            "distress": "Higher",
            "use": "Lower"
          },
          {
            "group": "Higher distress, higher use",
            "distress": "Higher",
            "use": "Higher"
          }
        ]
      },
      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "distress",
          "type": "ordinal",
          "sort": [
            "Lower",
            "Higher"
          ],
          "title": "Distress →",
          "axis": {
            "labelAngle": 0,
            "domain": false,
            "ticks": false
          }
        },
        "y": {
          "field": "use",
          "type": "ordinal",
          "sort": [
            "Higher",
            "Lower"
          ],
          "title": "Service use →",
          "axis": {
            "domain": false,
            "ticks": false
          }
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Lower distress, lower use",
              "Lower distress, higher use",
              "Higher distress, lower use",
              "Higher distress, higher use"
            ],
            "range": [
              "#d3dce6",
              "#7fb3d5",
              "#e8a07e",
              "#3d5a80"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "spacing": 30,
  "config": {
    "view": {
      "stroke": null
    }
  }
}