        },
        "text": {
          "field": "text"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "text": "NT Outback: 28, the lowest",
            "align": "center",
            "tl": 133.4,
            "tt": -23.0,
            "ll": 133.4,
            "lt": -22.2,
            "sl": 133.375,
            "st": -19.9
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "fontStyle": "italic",
        "color": "#1d4e89",
        "align": "center",
        "baseline": "top"
      },
      "encoding": {
        "longitude": {
          "field": "tl",
          "type": "quantitative"
        },
        "latitude": {
          "field": "tt",
          "type": "quantitative"
        },
        "text": {
          "field": "text"
        }
      }
    }
  ]
}