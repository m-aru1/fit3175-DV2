{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Line chart: % of Australians reporting a long-term mental or behavioural condition, and % of adults with high/very high psychological distress, in each National Health Survey 2001-2022 (ABS NHS 2022, Table 1).",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 320,
  "layer": [
    {
      "data": {
        "values": [
          {
            "from": 2020,
            "to": 2022.9
          }
        ]
      },
      "mark": {
        "type": "rect",
        "color": "#eef3f8"
      },
      "encoding": {
        "x": {
          "field": "from",
          "type": "quantitative",
          "scale": {
            "domain": [
              2000,
              2034
            ]
          }
        },
        "x2": {
          "field": "to"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2021.45,
            "label": "COVID-19"
          }
        ]
      },
      "mark": {
        "type": "text",
        "baseline": "top",
        "y": 6,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#5a6b82"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2011.5,
            "y": 19.5,
            "label": "Conditions almost tripled since 2001"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "fontSize": 12,
        "fontStyle": "italic",
        "color": "#1d4e89"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "url": "data/nhs_trend.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "percent": "number"
          }
        }
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "title": "Survey year",
          "axis": {
            "values": [
              2001,
              2004.5,
              2007.5,
              2011.5,
              2014.5,
              2017.5,
              2022
            ],
            "labelExpr": "{'2001': '2001', '2004.5': '2004–05', '2007.5': '2007–08', '2011.5': '2011–12', '2014.5': '2014–15', '2017.5': '2017–18', '2022': '2022'}[datum.value + '']",
            "grid": false
          }
        },
        "y": {
          "field": "percent",
          "type": "quantitative",
          "title": "% of people",
          "scale": {
            "domain": [
              0,
              30
            ]
          }
        },
        "color": {
          "field": "measure",
          "type": "nominal",
          "scale": {
            "range": [
              "#e07a5f",
              "#1d4e89"
            ]
          },
          "legend": null
        }
      },
      "layer": [
        {
          "params": [
            {
              "name": "hover",
              "select": {
                "type": "point",
                "fields": [
                  "measure"
                ],
                "on": "pointerover",
                "clear": "pointerout"
              }
            }
          ],
          "mark": {
            "type": "line",
            "strokeWidth": 3,
            "point": {
              "size": 60,
              "filled": true
            }
          },
          "encoding": {
            "opacity": {
              "condition": {
                "param": "hover",
                "empty": true,
                "value": 1
              },
              "value": 0.25
            },
            "tooltip": [
              {
                "field": "survey",
                "title": "Survey"
              },
              {
                "field": "measure",
                "title": "Measure"
              },
              {
                "field": "percent",
                "title": "%",
                "format": ".1f"
              }
            ]
          }
        },
        {
          "transform": [
            {
              "filter": "datum.year == 2022"
            },
            {
              "calculate": "format(datum.percent, '.1f') + '%  ' + (indexof(datum.measure, 'distress') >= 0 ? 'high distress (adults)' : 'mental/behavioural condition')",
              "as": "endLabel"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 10,
            "fontSize": 13,
            "fontWeight": 600
          },
          "encoding": {
            "text": {
              "field": "endLabel"
            }
          }
        }
      ]
    }
  ]
}
