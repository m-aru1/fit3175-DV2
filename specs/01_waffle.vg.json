{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: out of every 100 Australians aged 16-85, how many have had a mental disorder at some time in their life, and in the last 12 months (ABS NSMHW 2020-22).",
  "data": {
    "url": "data/nsmhw_headline.csv",
    "format": {
      "type": "csv",
      "parse": {
        "percent": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.measure == 'Lifetime mental disorder' ? 'At some time in their life' : 'In the past 12 months'",
      "as": "panel"
    },
    {
      "calculate": "sequence(0, 100)",
      "as": "cell"
    },
    {
      "flatten": [
        "cell"
      ]
    },
    {
      "calculate": "datum.cell % 10",
      "as": "col"
    },
    {
      "calculate": "floor(datum.cell / 10)",
      "as": "row"
    },
    {
      "calculate": "datum.cell < round(datum.percent) ? 'Had a mental disorder' : 'Did not'",
      "as": "status"
    }
  ],
  "facet": {
    "column": {
      "field": "panel",
      "type": "nominal",
      "sort": [
        "At some time in their life",
        "In the past 12 months"
      ],
      "title": null,
      "header": {
        "labelFontSize": 15,
        "labelFontWeight": 600,
        "labelPadding": 10,
        "labelColor": "#13213a"
      }
    }
  },
  "spacing": 28,
  "spec": {
    "width": 180,
    "height": 180,
    "mark": {
      "type": "square",
      "size": 200,
      "cornerRadius": 3,
      "opacity": 1
    },
    "encoding": {
      "x": {
        "field": "col",
        "type": "ordinal",
        "axis": null
      },
      "y": {
        "field": "row",
        "type": "ordinal",
        "axis": null,
        "sort": "descending"
      },
      "color": {
        "field": "status",
        "type": "nominal",
        "scale": {
          "domain": [
            "Had a mental disorder",
            "Did not"
          ],
          "range": [
            "#1d4e89",
            "#dce7f2"
          ]
        },
        "legend": {
          "orient": "bottom",
          "title": null,
          "labelLimit": 250,
          "columnPadding": 16
        }
      },
      "tooltip": [
        {
          "field": "measure",
          "title": "Measure"
        },
        {
          "field": "percent",
          "title": "% of people aged 16–85",
          "format": ".1f"
        }
      ]
    }
  },
  "resolve": {
    "scale": {
      "x": "independent",
      "y": "independent"
    }
  }
}
