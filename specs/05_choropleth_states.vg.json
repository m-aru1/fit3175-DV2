{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Choropleth map of Australian states and territories. A drop-down switches between three indicators: high/very high psychological distress (ABS NHS 2022), long-term mental or behavioural condition (ABS NHS 2022) and 12-month mental disorder (ABS NSMHW 2020-22).",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 420,
  "params": [
    {
      "name": "indicator",
      "value": "k10_high_vhigh",
      "bind": {
        "input": "select",
        "options": [
          "k10_high_vhigh",
          "mental_behavioural",
          "disorder_12m"
        ],
        "labels": [
          "High or very high distress (adults, 2022)",
          "Long-term mental/behavioural condition (2022)",
          "12-month mental disorder (ages 16–85, 2020–22)"
        ],
        "name": "Indicator: "
      }
    }
  ],
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/australia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.STATE_NAME",
          "from": {
            "data": {
              "url": "data/states.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "k10_high_vhigh": "number",
                  "mental_behavioural": "number",
                  "disorder_12m": "number",
                  "mbs_patients": "number",
                  "mbs_rate": "number",
                  "mbs_services": "number",
                  "lon": "number",
                  "lat": "number",
                  "col": "number",
                  "row": "number",
                  "label_lon": "number",
                  "label_lat": "number"
                }
              }
            },
            "key": "state",
            "fields": [
              "abbr",
              "k10_high_vhigh",
              "mental_behavioural",
              "disorder_12m"
            ]
          }
        },
        {
          "calculate": "datum[indicator]",
          "as": "value"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "color": {
          "field": "value",
          "type": "quantitative",
          "title": "% of people",
          "scale": {
            "range": [
              "#e6f0fa",
              "#4f86c6"
            ],
            "zero": false
          },
          "legend": {
            "orient": "left",
            "direction": "vertical",
            "gradientLength": 120,
            "offset": 24
          }
        },
        "tooltip": [
          {
            "field": "properties.STATE_NAME",
            "title": "State / territory"
          },
          {
            "field": "k10_high_vhigh",
            "title": "High/very high distress (%)"
          },
          {
            "field": "mental_behavioural",
            "title": "Mental/behavioural condition (%)"
          },
          {
            "field": "disorder_12m",
            "title": "12-month mental disorder (%)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/states.csv",
        "format": {
          "type": "csv",
          "parse": {
            "k10_high_vhigh": "number",
            "mental_behavioural": "number",
            "disorder_12m": "number",
            "mbs_patients": "number",
            "mbs_rate": "number",
            "mbs_services": "number",
            "lon": "number",
            "lat": "number",
            "col": "number",
            "row": "number",
            "label_lon": "number",
            "label_lat": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "datum[indicator]",
          "as": "value"
        },
        {
          "calculate": "datum.abbr + ' ' + format(datum.value, '.1f') + '%'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#13213a"
      },
      "encoding": {
        "longitude": {
          "field": "label_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_lat",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}