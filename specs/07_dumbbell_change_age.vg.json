{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Vertical dumbbell chart: people per 1,000 receiving Medicare-subsidised mental health services in each age group, 2015-16 (light circle) vs 2024-25 (dark circle). The bar is blue where the rate went up and orange where it went down; the label underneath gives the % change (AIHW MBS Table MBS.4).",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 400,
  "data": {
    "url": "data/mbs_age_sex_trend.csv",
    "format": {
      "type": "csv",
      "parse": {
        "age_order": "number",
        "patients_per_1000": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.sex == 'Persons' && (datum.financial_year == '2015–16' || datum.financial_year == '2024–25')"
    },
    {
      "pivot": "financial_year",
      "value": "patients_per_1000",
      "groupby": [
        "age_group",
        "age_order"
      ]
    },
    {
      "calculate": "datum['2015–16']",
      "as": "then"
    },
    {
      "calculate": "datum['2024–25']",
      "as": "now"
    },
    {
      "calculate": "(datum.now - datum.then) / datum.then",
      "as": "change"
    },
    {
      "calculate": "datum.now > datum.then ? 'Went up' : datum.now < datum.then ? 'Went down' : 'No change'",
      "as": "direction"
    },
    {
      "calculate": "min(datum.then, datum.now)",
      "as": "low"
    },
    {
      "calculate": "(datum.change > 0 ? '▲ ' : datum.change < 0 ? '▼ ' : '') + format(abs(datum.change), '.0%')",
      "as": "changeLabel"
    }
  ],
  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "sort": {
        "field": "age_order"
      },
      "title": "Age group (years)",
      "axis": {
        "orient": "top",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "labelColor": "#13213a",
        "titlePadding": 10
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 7,
        "strokeCap": "round"
      },
      "encoding": {
        "y": {
          "field": "then",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              165
            ]
          },
          "title": "People per 1,000",
          "axis": {
            "grid": true,
            "domain": false,
            "ticks": false,
            "values": [
              0,
              50,
              100,
              150
            ]
          }
        },
        "y2": {
          "field": "now"
        },
        "color": {
          "field": "direction",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Went up",
              "Went down",
              "No change"
            ],
            "range": [
              "#1d4e89",
              "#e07a5f",
              "#b7c7d8"
            ]
          },
          "legend": {
            "orient": "top-right",
            "direction": "horizontal",
            "symbolType": "stroke",
            "symbolStrokeWidth": 6
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 480,
        "opacity": 1,
        "color": "#a9cce3",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "then",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age group"
          },
          {
            "field": "then",
            "title": "2015–16 (per 1,000)"
          },
          {
            "field": "now",
            "title": "2024–25 (per 1,000)"
          },
          {
            "field": "change",
            "title": "Change",
            "format": "+.0%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 480,
        "opacity": 1,
        "color": "#0b2545",
        "stroke": "white",
        "strokeWidth": 1.5
      },
      "encoding": {
        "y": {
          "field": "now",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "age_group",
            "title": "Age group"
          },
          {
            "field": "then",
            "title": "2015–16 (per 1,000)"
          },
          {
            "field": "now",
            "title": "2024–25 (per 1,000)"
          },
          {
            "field": "change",
            "title": "Change",
            "format": "+.0%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 700,
        "color": "#13213a"
      },
      "encoding": {
        "y": {
          "field": "then",
          "type": "quantitative"
        },
        "text": {
          "field": "then"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 10,
        "fontWeight": 700,
        "color": "white"
      },
      "encoding": {
        "y": {
          "field": "now",
          "type": "quantitative"
        },
        "text": {
          "field": "now"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "baseline": "top",
        "dy": 20,
        "fontSize": 12,
        "fontWeight": 700
      },
      "encoding": {
        "y": {
          "field": "low",
          "type": "quantitative"
        },
        "text": {
          "field": "changeLabel"
        },
        "color": {
          "condition": [
            {
              "test": "datum.change > 0",
              "value": "#1d4e89"
            },
            {
              "test": "datum.change < 0",
              "value": "#e07a5f"
            }
          ],
          "value": "#5a6b82"
        }
      }
    }
  ]
}
